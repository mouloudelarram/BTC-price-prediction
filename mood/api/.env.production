# Production Environment Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENVIRONMENT=production
API_DEBUG=False

# Scrapper Configuration
SCRAPPER_BASE_URL=http://localhost:8001
SCRAPPER_TIMEOUT=600
SCRAPPER_RETRIES=3

# LLM Configuration
LLM_BASE_URL=http://localhost:8002
LLM_TIMEOUT=300
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral-large-3:675b-cloud
CONCURRENCY_LIMIT=5

# Data Paths
DATA_DIR=../scrapper/data_sourcing/output
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./output

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/api.log

# Database/Cache
CACHE_ENABLED=true
CACHE_TTL=7200

# Security
API_KEY_ENABLED=true
API_KEY=your-production-secret-key-here

# CORS
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Platform Weights
FEAR_GREED_WEIGHT=0.30
COINDESK_WEIGHT=0.25
REDDIT_WEIGHT=0.15
TRUTH_SOCIAL_WEIGHT=0.10
BINANCE_WEIGHT=0.10
COINGECKO_WEIGHT=0.10
